/// A curated, discounted, price-capped set of a single tutor's courses.
/// Bundles carry no split rate of their own - line items inherit the normal
/// attribution rates, because a bundle is a packaging format, not an
/// acquisition channel.
model CourseBundle {
  id          String             @id @default(cuid())
  title       String
  slug        String             @unique
  description String?
  price       Float
  currency    String             @default("NGN")

  /// Tutor-controlled on/off switch. Independent of review state: a tutor can
  /// pause an approved bundle without losing approval.
  isActive    Boolean            @default(true)

  /// Platform review. Publicly purchasable only when APPROVED *and* isActive.
  reviewStatus BundleReviewStatus @default(DRAFT)
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?
  submittedAt  DateTime?

  tutorId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor      Tutor              @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("BundleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items      CourseBundleItem[]

  @@index([reviewStatus, isActive])
  @@map("course_bundles")
}

model CourseBundleItem {
  id       String @id @default(cuid())
  bundleId String
  courseId String

  bundle CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([bundleId, courseId])
  @@map("course_bundle_items")
}

enum BundleReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Append-only record of every change to User.walletBalance.
///
/// TutorEarning answers "what did I earn, and at what rate". This answers the
/// different question "why is my balance this number" — including movements
/// that are not earnings at all, like withdrawals and group cashback. Group
/// cashback in particular moved money on both sides while writing nothing,
/// which made wallet balances impossible to reconcile.
///
/// Invariant: walletBalance == sum(WalletEntry.amount) for a user.
model WalletEntry {
  id     String          @id @default(cuid())
  userId String
  /// Signed: positive credits the wallet, negative debits it.
  amount Float
  type   WalletEntryType
  /// Balance immediately after this entry, for auditing without replaying.
  balanceAfter Float?
  description  String?

  // Loose references. Nullable because no single one applies to every type.
  transactionId       String?
  tutorEarningId      String?
  withdrawalRequestId String?
  groupPurchaseId     String?

  createdAt DateTime @default(now())

  user User @relation("UserWalletEntries", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
  @@map("wallet_entries")
}

enum WalletEntryType {
  COURSE_EARNING
  MENTORSHIP_EARNING
  PROGRAM_EARNING_RELEASE
  GROUP_CASHBACK_CREDIT
  GROUP_CASHBACK_DEBIT
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_REVERSED
  /// Student spent group-buying cashback against a purchase.
  COURSE_CREDIT_APPLIED
