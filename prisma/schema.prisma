generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  avatar                  String?
  role                    UserRole                 @default(USER)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bio                     String?
  location                String?
  website                 String?
  socialLinks             Json?
  preferences             Json?
  timezone                String?
  language                String                   @default("en")
  emailVerified           DateTime?
  phone                   String?
  password                String?
  isVerified              Boolean                  @default(false)
  verificationToken       String                   @default("")
  mustChangePassword      Boolean                  @default(false)
  invitedBy               String?
  bankName                String?                  @map("bank_name")
  accountNumber           String?                  @map("account_number")
  subaccountCode          String?                  @map("subaccount_code")
  recipientCode           String?                  @map("recipient_code")
  walletBalance           Float                    @default(0)
  image                   String?
  failedLoginAttempts     Int                      @default(0)
  accountLockedUntil      DateTime?
  lastLoginAt             DateTime?
  lastLoginIp             String?
  lastFailedLoginAt       DateTime?
  lastFailedLoginIp       String?
  accounts                Account[]
  adminProfile            Admin?
  advisorFollowUps        AdvisorFollowUp[]
  advisorSessions         AdvisorSession[]
  AIRecommendation        AIRecommendation[]
  cartItems               CartItem[]
  certificates            Certificate[]
  createdCourses          Course[]                 @relation("CourseCreator")
  ownedCourses            Course[]                 @relation("CourseOwner")
  discussionReplies       DiscussionReply[]
  discussions             Discussion[]
  enrollments             Enrollment[]
  groupMemberships        GroupMember[]
  createdGroupPurchases   GroupPurchase[]          @relation("GroupPurchaseCreator")
  LearningPath            LearningPath[]
  mentorshipPackageOrders MentorshipPackageOrder[] @relation("StudentPackageOrders")
  mentoredPackageOrders   MentorshipPackageOrder[] @relation("TutorPackageOrders")
  mentorshipPackages      MentorshipPackage[]      @relation("MentorPackages")
  mentorSessions          MentorshipSession[]      @relation("StudentSessions")
  tutoredSessions         MentorshipSession[]      @relation("TutorSessions")
  notifications           Notification[]
  paymentMethod           PaymentMethod[]
  ProgressMilestone       ProgressMilestone[]
  allowedPromoCodes       PromoCodeUser[]
  createdPromoCodes       PromoCode[]              @relation("PromoCreator")
  promoRedemptions        PromoRedemption[]
  QuizAnswer              QuizAnswer[]
  reports                 Report[]
  reviewReactions         ReviewReaction[]
  reviews                 Review[]
  sessions                Session[]
  studentProfile          Student?
  submissions             Submission[]
  taskSubmissions         TaskSubmission[]
  transactionLineItems    TransactionLineItem[]
  transactions            Transaction[]
  tutorEarnings           TutorEarning[]           @relation("TutorEarningTutor")
  releasedEarnings        TutorEarning[]           @relation("TutorEarningReleasedBy")
  ledCohorts              ProgramCohort[]          @relation("CohortLeadInstructor")
  walletEntries           WalletEntry[]            @relation("UserWalletEntries")
  reviewedBundles         CourseBundle[]           @relation("BundleReviewer")
  tutorProfile            Tutor?
  analytics               UserAnalytics[]
  UserSkill               UserSkill[]
  wishlist                Wishlist[]
  approvedWithdrawals     WithdrawalRequest[]      @relation("WithdrawalApprover")
  withdrawalRequests      WithdrawalRequest[]
  programEnrollments      ProgramEnrollment[]
  promotions              CoursePromotion[]        @relation("PromotionCreator")
  blogLikes               BlogLike[]               @relation("UserBlogLikes")
  blogViews               BlogView[]               @relation("UserBlogViews")
  blogBookmarks           BlogBookmark[]           @relation("UserBlogBookmarks")
  blogComments            BlogComment[]            @relation("UserBlogComments")
  bootcampEnrollments     BootcampEnrollment[]     @relation("UserBootcampEnrollments")
  bootcampTeams           BootcampTeam[]           @relation("UserBootcampTeams")

  // Exam Center
  questionBankSharesGranted QuestionBankShare[]   @relation("QuestionBankShareGrantor")
  bankQuestionsAuthored     BankQuestion[]        @relation("BankQuestionAuthor")
  questionImportBatches     QuestionImportBatch[] @relation("QuestionImporter")
  examsCreated              Exam[]                @relation("ExamCreator")
  examCandidacies           ExamCandidate[]       @relation("ExamCandidacies")
  examAttempts              ExamAttempt[]         @relation("ExamAttempts")
  examAttemptsVoided        ExamAttempt[]         @relation("ExamAttemptVoider")
  examResponsesGraded       ExamResponse[]        @relation("ExamResponseGrader")
  examGrades                ExamGrade[]           @relation("ExamGrades")
  examGradesReleased        ExamGrade[]           @relation("ExamGradeReleaser")
  examGradesOverridden      ExamGrade[]           @relation("ExamGradeOverrider")
  examGradeAudits           ExamGradeAudit[]      @relation("ExamGradeAuditor")
  examEvents                ExamEvent[]           @relation("ExamEvents")

  @@map("users")
}

model Student {
  id               String         @id @default(cuid())
  userId           String         @unique
  level            EducationLevel @default(BEGINNER)
  interests        String[]
  goals            String[]
  studyHours       Int            @default(0)
  completedHours   Int            @default(0)
  streak           Int            @default(0)
  lastActiveDate   DateTime?
  totalPoints      Int            @default(0)
  currentRank      String         @default("Novice")
  hasStudentId     Boolean        @default(false)
  coursesStarted   Int            @default(0)
  coursesCompleted Int            @default(0)
  averageScore     Float?
  totalAssignments Int            @default(0)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("students")
}

model Tutor {
  id             String    @id @default(cuid())
  userId         String    @unique
  title          String
  expertise      String[]
  experience     Int
  education      String[]
  certifications String[]
  hourlyRate     Float?
  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  course         String?
  totalStudents  Int       @default(0)
  totalCourses   Int       @default(0)
  totalEarnings  Float     @default(0)
  averageRating  Float     @default(0)
  totalReviews   Int       @default(0)
  responseTime   Int       @default(24)
  completionRate Float     @default(0)
  availability   Json?
  timezone       String?
  referralCode   String?   @unique @map("referral_code")
  Course         Course[]
  bundles        CourseBundle[]
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Exam Center
  questionBanks      QuestionBank[]
  bankSharesReceived QuestionBankShare[]
  exams              Exam[]

  @@map("tutors")
}

model Admin {
  id          String     @id @default(cuid())
  userId      String     @unique
  permissions String[]
  department  String?
  level       AdminLevel @default(MODERATOR)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Course {
  id                     String                  @id @default(cuid())
  title                  String
  slug                   String?                 @unique
  description            String
  thumbnail              String?
  trailer                String?
  price                  Float
  salePrice              Float?
  currency               String                  @default("NGN")
  level                  CourseLevel             @default(BEGINNER)
  status                 CourseStatus            @default(DRAFT)
  courseType             CourseType              @default(REGULAR)
  language               String                  @default("en")
  duration               Int?
  totalLessons           Int                     @default(0)
  totalQuizzes           Int                     @default(0)
  totalProjects          Int                     @default(0)
  requirements           String[]
  outcomes               String[]
  targetAudience         String[]
  metaTitle              String?
  metaDescription        String?
  publishedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  virtualPrice           Float?
  physicalPrice          Float?
  certificate            Boolean?                @default(false)
  categoryId             String
  creatorId              String
  ownerId                String?
  basePrice              Float?
  currentPrice           Float?
  demandLevel            String?
  flashSaleEnd           DateTime?
  groupBuyingDiscount    Float?
  groupBuyingEnabled     Boolean                 @default(false)
  isFlashSale            Boolean                 @default(false)
  previewVideo           String?
  subtitle               String
  tutorId                String
  allowDiscussions       Boolean                 @default(false)
  tags                   CourseTag[]
  advisorRecommendations AdvisorRecommendation[]
  AIRecommendation       AIRecommendation[]      @relation("CourseRecommendations")
  cartItems              CartItem[]
  certificates           Certificate[]
  analytics              CourseAnalytics[]
  modules                CourseModule[]
  category               Category                @relation(fields: [categoryId], references: [id])
  creator                User                    @relation("CourseCreator", fields: [creatorId], references: [id])
  owner                  User?                   @relation("CourseOwner", fields: [ownerId], references: [id])
  tutor                  Tutor                   @relation(fields: [tutorId], references: [id])
  discussions            Discussion[]
  enrollments            Enrollment[]
  groupPurchases         GroupPurchase[]
  groupTiers             GroupTier[]
  LearningPath           LearningPath[]
  projects               Project[]
  promoCodes             PromoCode[]
  bundleItems            CourseBundleItem[]
  promoRedemptions       PromoRedemption[]
  reviews                Review[]
  Skill                  Skill[]
  tasks                  Task[]
  transactionLineItems   TransactionLineItem[]
  transactions           Transaction[]
  tutorEarnings          TutorEarning[]
  wishlist               Wishlist[]
  mentorshipSessions     MentorshipSession[]
  promotions             CoursePromotion[]

  // Exam Center
  exams         Exam[]
  questionBanks QuestionBank[]

  @@map("courses")
}

model CourseTag {
  id       String @id @default(cuid())
  name     String
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
}

model Category {
  id                     String                  @id @default(cuid())
  name                   String                  @unique
  slug                   String                  @unique
  description            String?
  icon                   String?
  color                  String?
  isActive               Boolean                 @default(true)
  sortOrder              Int                     @default(0)
  parentId               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  advisorRecommendations AdvisorRecommendation[]
  parent                 Category?               @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children               Category[]              @relation("CategoryHierarchy")
  courses                Course[]

  @@map("categories")
}

model CourseModule {
  id          String     @id @default(cuid())
  title       String
  description String?
  sortOrder   Int
  duration    Int
  isPublished Boolean    @default(false)
  courseId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  content     String?
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  projects    Project[]
  resources   Resource[]
  tasks       Task[]

  @@map("course_modules")
}

model Lesson {
  id          String           @id @default(cuid())
  title       String
  description String?
  content     String?
  videoUrl    String?
  duration    Int
  sortOrder   Int
  isPreview   Boolean          @default(false)
  lessonType  LessonType       @default(VIDEO)
  moduleId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  isLocked    Boolean          @default(false)
  progress    LessonProgress[]
  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz        Quiz?
  resources   Resource[]

  @@map("lessons")
}

model LessonProgress {
  id           String     @id @default(cuid())
  isCompleted  Boolean    @default(false)
  watchTime    Int        @default(0)
  completedAt  DateTime?
  userId       String
  lessonId     String
  enrollmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Enrollment {
  id                String           @id @default(cuid())
  progress          Float            @default(0)
  status            EnrollmentStatus @default(ACTIVE)
  completedAt       DateTime?
  certificateIssued Boolean          @default(false)
  userId            String
  courseId          String
  enrolledAt        DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  groupPurchaseId   String?
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupPurchase     GroupPurchase?   @relation(fields: [groupPurchaseId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Quiz {
  id           String        @id @default(cuid())
  title        String
  description  String?
  timeLimit    Int?
  passingScore Int           @default(70)
  maxAttempts  Int           @default(3)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lessonId     String        @unique
  questions    Question[]
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  QuizAnswer   QuizAnswer[]
  attempts     QuizAttempt[]

  @@map("quiz")
}

model Question {
  id            String       @id @default(cuid())
  question      String
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  options       Json?
  correctAnswer Json
  explanation   String?
  points        Int          @default(1)
  sortOrder     Int
  quizId        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  QuizAnswer    QuizAnswer[]

  @@map("questions")
}

model QuizAttempt {
  id           String     @id @default(cuid())
  score        Float
  answers      Json
  timeSpent    Int
  isCompleted  Boolean    @default(false)
  userId       String
  quizId       String
  enrollmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  attempts     Int        @default(1)
  passed       Boolean?   @default(false)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model QuizAnswer {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  aiExplanation  String?
  submittedAt    DateTime @default(now())
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_answers")
}

model Project {
  id           String        @id @default(cuid())
  title        String
  description  String
  requirements String[]
  difficulty   CourseLevel   @default(BEGINNER)
  points       Int           @default(100)
  dueDate      DateTime?
  isActive     Boolean       @default(true)
  courseId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  moduleId     String?
  scope        ProjectScope  @default(COURSE)
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources    Resource[]
  submissions  Submission[]

  @@map("projects")
}

model Submission {
  id        String           @id @default(cuid())
  content   String?
  fileUrl   String?
  githubUrl String?
  liveUrl   String?
  notes     String?
  status    SubmissionStatus @default(PENDING)
  score     Float?
  feedback  String?
  gradedAt  DateTime?
  userId    String
  projectId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("submissions")
}

model Task {
  id             String             @id @default(cuid())
  title          String
  description    String
  requirements   String[]
  points         Int                @default(100)
  dueDate        DateTime?
  isActive       Boolean            @default(true)
  submissionType TaskSubmissionType @default(TEXT)
  courseId       String
  moduleId       String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  resources      Resource[]
  submissions    TaskSubmission[]
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module         CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model TaskSubmission {
  id        String           @id @default(cuid())
  content   String?
  fileUrl   String?
  githubUrl String?
  liveUrl   String?
  notes     String?
  status    SubmissionStatus @default(PENDING)
  score     Float?
  feedback  String?
  gradedAt  DateTime?
  userId    String
  taskId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@map("task_submissions")
}

model LearningPath {
  id          String              @id @default(cuid())
  userId      String
  courseId    String
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  ProgressMilestone[]

  @@map("learning_paths")
}

model Skill {
  id                String             @id @default(cuid())
  name              String             @unique
  description       String?
  courseId          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aiRecommendations AIRecommendation[] @relation("SkillRecommendations")
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userSkills        UserSkill[]

  @@map("skills")
}

model UserSkill {
  id         String         @id @default(cuid())
  userId     String
  skillId    String
  level      EducationLevel @default(BEGINNER)
  acquiredAt DateTime       @default(now())
  skill      Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_skills")
}

model ProgressMilestone {
  id             String        @id @default(cuid())
  userId         String
  learningPathId String?
  type           MilestoneType
  description    String
  achievedAt     DateTime      @default(now())
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_milestones")
}

model AIRecommendation {
  id          String   @id @default(cuid())
  userId      String
  courseId    String?
  skillId     String?
  type        String
  description String
  createdAt   DateTime @default(now())
  course      Course?  @relation("CourseRecommendations", fields: [courseId], references: [id], onDelete: Cascade)
  skill       Skill?   @relation("SkillRecommendations", fields: [skillId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

model AdvisorSession {
  id           String            @id @default(cuid())
  sessionToken String            @unique
  userId       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  followUps    AdvisorFollowUp[]
  user         User?             @relation(fields: [userId], references: [id])
  turns        AdvisorTurn[]

  @@index([userId])
  @@map("advisor_sessions")
}

model AdvisorTurn {
  id               String                  @id @default(cuid())
  advisorSessionId String
  userMessage      String
  assistantMessage String
  createdAt        DateTime                @default(now())
  followUps        AdvisorFollowUp[]
  recommendations  AdvisorRecommendation[]
  advisorSession   AdvisorSession          @relation(fields: [advisorSessionId], references: [id], onDelete: Cascade)

  @@index([advisorSessionId, createdAt])
  @@map("advisor_turns")
}

model AdvisorRecommendation {
  id            String      @id @default(cuid())
  advisorTurnId String
  courseId      String?
  categoryId    String?
  reason        String
  rank          Int         @default(0)
  createdAt     DateTime    @default(now())
  advisorTurn   AdvisorTurn @relation(fields: [advisorTurnId], references: [id], onDelete: Cascade)
  category      Category?   @relation(fields: [categoryId], references: [id])
  course        Course?     @relation(fields: [courseId], references: [id])

  @@index([advisorTurnId, rank])
  @@index([courseId])
  @@index([categoryId])
  @@map("advisor_recommendations")
}

model AdvisorFollowUp {
  id               String                @id @default(cuid())
  advisorSessionId String
  advisorTurnId    String?
  userId           String?
  name             String
  email            String
  note             String?
  status           AdvisorFollowUpStatus @default(NEW)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  advisorSession   AdvisorSession        @relation(fields: [advisorSessionId], references: [id], onDelete: Cascade)
  advisorTurn      AdvisorTurn?          @relation(fields: [advisorTurnId], references: [id])
  user             User?                 @relation(fields: [userId], references: [id])

  @@index([advisorSessionId, createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@map("advisor_follow_ups")
}

model MentorshipSession {
  id                String                  @id @default(cuid())
  title             String
  description       String?
  duration          Int
  price             Float
  status            SessionStatus           @default(SCHEDULED)
  meetingUrl        String?
  notes             String?
  feedback          String?
  rating            Int?
  scheduledAt       DateTime
  startedAt         DateTime?
  endedAt           DateTime?
  studentId         String
  tutorId           String
  courseId          String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  bookingMode       MentorshipBookingMode   @default(INSTANT)
  packageName       String?
  packageSessions   Int?
  paymentStatus     MentorshipPaymentStatus @default(PENDING)
  approvalNotes     String?
  rejectedAt        DateTime?
  approvalDeadline  DateTime?
  isOffering        Boolean                 @default(false)
  offeringSessionId String? // Reference to original offering if this is a booking
  bookingStartTime  DateTime? // When student selected to start within offering
  bookingEndTime    DateTime? // When student selected to end (for time slot booking)
  student           User                    @relation("StudentSessions", fields: [studentId], references: [id], onDelete: Cascade)
  tutor             User                    @relation("TutorSessions", fields: [tutorId], references: [id], onDelete: Cascade)
  course            Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)
  offering          MentorshipSession?      @relation("OfferingBookings", fields: [offeringSessionId], references: [id], onDelete: Cascade)
  bookings          MentorshipSession[]     @relation("OfferingBookings")
  transactions      Transaction[]
  tutorEarning      TutorEarning?

  @@map("mentorship_sessions")
}

model MentorshipPackage {
  id              String                   @id @default(cuid())
  tutorId         String
  name            String
  description     String?
  sessionsCount   Int
  sessionDuration Int
  basePrice       Float
  packagePrice    Float
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  orders          MentorshipPackageOrder[]
  tutor           User                     @relation("MentorPackages", fields: [tutorId], references: [id], onDelete: Cascade)

  @@map("mentorship_packages")
}

model MentorshipPackageOrder {
  id                String                       @id @default(cuid())
  packageId         String
  studentId         String
  tutorId           String
  sessionsTotal     Int
  sessionsRemaining Int
  status            MentorshipPackageOrderStatus @default(ACTIVE)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  package           MentorshipPackage            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  student           User                         @relation("StudentPackageOrders", fields: [studentId], references: [id], onDelete: Cascade)
  tutor             User                         @relation("TutorPackageOrders", fields: [tutorId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@map("mentorship_package_orders")
}

model Registration {
  id         String   @id @default(cuid())
  firstname  String
  lastname   String
  email      String   @unique
  occupation String
  course     String
  type       String   @default("physical")
  phone      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("registrations")
}

model ProgramRegistration {
  id          String   @id @default(cuid())
  fullName    String
  age         Int
  dateOfBirth DateTime
  phoneNumber String
  email       String   @unique
