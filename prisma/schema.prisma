/// One ledger for every kind of tutor earning. COURSE earnings are credited to
/// the wallet immediately at settlement; PROGRAM earnings are accrued PENDING
/// and only credited when an admin releases them (see availableAt).
model TutorEarning {
  id                    String               @id @default(cuid())
  tutorId               String
  source                TutorEarningSource   @default(COURSE)
  amount                Float
  splitPercent          Float
  status                TutorEarningStatus   @default(AVAILABLE)

  // COURSE earnings only. Nullable so PROGRAM earnings, which have no
  // Transaction, can share this table.
  transactionId         String?
  transactionLineItemId String?
  courseId              String?

  // MENTORSHIP earnings only. Unique so a replayed settlement cannot credit
  // the same session twice.
  mentorshipSessionId  String?              @unique

  // PROGRAM earnings only.
  programEnrollmentId  String?
  /// Idempotency key: accrual fires from both payment and instructor
  /// assignment, and this is what makes the second one a no-op.
  installmentPaymentId String?               @unique
  cohortId             String?

  /// Earliest moment this may be released: max(paidAt + refund window,
  /// cohort start). Null for COURSE earnings, which are available at once.
  availableAt           DateTime?
  releasedAt            DateTime?
  releasedById          String?

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  course              Course?              @relation(fields: [courseId], references: [id])
  transaction         Transaction?         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionLineItem TransactionLineItem? @relation(fields: [transactionLineItemId], references: [id], onDelete: Cascade)
  tutor               User                 @relation("TutorEarningTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  programEnrollment   ProgramEnrollment?   @relation(fields: [programEnrollmentId], references: [id], onDelete: Cascade)
  installmentPayment  InstallmentPayment?  @relation(fields: [installmentPaymentId], references: [id], onDelete: Cascade)
  cohort              ProgramCohort?       @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  mentorshipSession   MentorshipSession?   @relation(fields: [mentorshipSessionId], references: [id], onDelete: SetNull)
  releasedBy          User?                @relation("TutorEarningReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([tutorId, status])
  @@index([cohortId, status])
  @@map("tutor_earnings")
}

